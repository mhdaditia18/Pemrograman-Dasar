    {
      "cell_type": "code",
      "source": [
        "kapasitas_gen = int(input(\"Masukkan kapasitas generator (kW): \"))\n",
        "jam_operasi = int(input(\"Masukkan jam beroperasi per hari (jam/hari): \"))\n",
        "konsumsi_solar_per_kWh = float(input(\"Masukkan konsumsi bahan bakar (liter per kWh): \"))\n",
        "harga_solar = int(input(\"Masukkan harga solar per liter (Rp): \"))\n",
        "kapasitas_tangki = int(input(\"Masukkan kapasitas tangki (liter): \"))\n",
        "arus_kabel = int(input(\"Masukkan arus kabel (A): \"))\n",
        "hambatan_kabel = float(input(\"Masukkan hambatan kabel (Ohm): \"))\n",
        "\n",
        "energi_kWh = kapasitas_gen * jam_operasi\n",
        "\n",
        "solar_liter = energi_kWh * konsumsi_solar_per_kWh\n",
        "biaya_rp = solar_liter * harga_solar\n",
        "\n",
        "tangki_cukup = kapasitas_tangki // solar_liter\n",
        "sisa_solar = kapasitas_tangki % solar_liter\n",
        "\n",
        "rugi_kabel = (arus_kabel ** 2) * hambatan_kabel\n",
        "\n",
        "rugi_tinggi = rugi_kabel > 150 and arus_kabel >= 20\n",
        "\n",
        "print(\"\\n--- Hasil Perhitungan ---\")\n",
        "print(f\"Energi (kWh)  : {int(energi_kWh)}\")\n",
        "print(f\"Solar (liter) : {int(solar_liter)}\")\n",
        "print(f\"Biaya (Rp)    : {int(biaya_rp)}\")\n",
        "print(f\"Tangki cukup  : {round(tangki_cukup, 1)} hari\")\n",
        "print(f\"Sisa solar (L): {round(sisa_solar, 1)}\")\n",
        "print(f\"Rugi kabel (W): {round(rugi_kabel, 1)}\")\n",
        "print(f\"Rugi tinggi?  : {rugi_tinggi}\")"
      ],
