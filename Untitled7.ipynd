        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Masukkan jumlah buku: 7\n",
            "Masukkan harga per buku: 18500\n",
            "Masukkan persentase diskon (dalam %): 10\n",
            "Masukkan uang yang dibayarkan Budi: 150000\n",
            "Masukkan jumlah orang untuk patungan: 4\n",
            "\n",
            "Detail Transaksi:\n",
            "Total       : 129500\n",
            "Diskon      : 12950\n",
            "Bayar       : 116550\n",
            "Kembalian   : 33450\n",
            "Per orang   : 29137\n",
            "Sisa        : 2\n",
            "Uang cukup? : True\n"
          ]
        }
      ],
      "source": [
        "jumlah_buku = int(input(\"Masukkan jumlah buku: \"))\n",
        "harga_per_buku = int(input(\"Masukkan harga per buku: \"))\n",
        "persen_diskon = float(input(\"Masukkan persentase diskon (dalam %): \"))\n",
        "uang_budi = int(input(\"Masukkan uang yang dibayarkan Budi: \"))\n",
        "jumlah_orang = int(input(\"Masukkan jumlah orang untuk patungan: \"))\n",
        "\n",
        "total = jumlah_buku * harga_per_buku\n",
        "diskon = int(total * (persen_diskon / 100))\n",
        "bayar = total - diskon\n",
        "kembalian = uang_budi - bayar\n",
        "\n",
        "per_orang = bayar // jumlah_orang\n",
        "sisa = bayar % jumlah_orang\n",
        "\n",
        "uang_cukup = uang_budi >= bayar\n",
        "\n",
        "print(\"\\nDetail Transaksi:\")\n",
        "print(f\"Total       : {total}\")\n",
        "print(f\"Diskon      : {diskon}\")\n",
        "print(f\"Bayar       : {bayar}\")\n",
        "print(f\"Kembalian   : {kembalian}\")\n",
        "print(f\"Per orang   : {per_orang}\")\n",
        "print(f\"Sisa        : {sisa}\")\n",
        "print(f\"Uang cukup? : {uang_cukup}\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "jumlah_panel = int(input(\"Masukkan jumlah panel surya: \"))\n",
        "daya_panel = int(input(\"Masukkan kapasitas panel (Wp): \"))\n",
        "jam_sinar = float(input(\"Masukkan rata-rata penyinaran efektif (jam/hari): \"))\n",
        "efisiensi = float(input(\"Masukkan efisiensi sistem (desimal, misal 0.8): \"))\n",
        "kebutuhan_rumah = float(input(\"Masukkan kebutuhan listrik rumah (kWh/hari): \"))\n",
        "tarif_listrik = float(input(\"Masukkan tarif listrik PLN (Rp/kWh): \"))\n",
        "\n",
        "energi_harian = (jumlah_panel * daya_panel * jam_sinar * efisiensi) / 1000\n",
        "\n",
        "energi_bulanan = energi_harian * 30\n",
        "nilai_listrik = energi_bulanan * tarif_listrik\n",
        "\n",
        "kekurangan_kWh = kebutuhan_rumah - energi_harian\n",
        "\n",
        "mencukupi = energi_harian >= kebutuhan_rumah\n",
        "\n",
        "print(\"\\n--- Hasil Perhitungan ---\")\n",
        "print(f\"Energi harian (kWh)  : {round(energi_harian, 1)}\")\n",
        "print(f\"Energi bulanan (kWh) : {round(energi_bulanan, 1)}\")\n",
        "print(f\"Nilai listrik (Rp)   : {round(nilai_listrik, 1)}\")\n",
        "print(f\"Kekurangan (kWh)     : {round(kekurangan_kWh, 1)}\")\n",
        "print(f\"Mencukupi?           : {mencukupi}\")"
      ],
      "metadata": {
